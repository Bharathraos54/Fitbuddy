# Supabase — Project Settings → API Keys (use the publishable / anon key, never the secret one)
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Anthropic — used by /api/generate-plan during onboarding
ANTHROPIC_API_KEY=your-anthropic-key-here

# Set to true to skip the Claude call and return a canned plan (local dev)
MOCK_AI=false
